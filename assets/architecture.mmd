flowchart LR
    browser["Frontend<br/>Static HTML · CSS · JavaScript<br/>Role based UI and SVG charts"]

    subgraph api["FastAPI backend"]
        auth["Authentication & authorization<br/>JWT · password hashing · role dependencies"]
        routes["HTTP routers<br/>validation · role gated endpoints"]
        inventory["Blood inventory<br/>stock · receipts · issues · expiry"]
        forecast["Demand forecasting engine<br/>baseline · exponential smoothing · SARIMA"]
        risk["Shortage risk<br/>transparent stock vs forecast rules"]
        matching["Smart donor matching<br/>compatibility · availability · consent · cooldown"]
        regional["Regional analytics<br/>bank risk · surplus · transfer suggestions"]
        other["Requests · screening · reports<br/>notifications · admin · evaluation"]
        services[("Domain services")]
    end

    db[("SQL database<br/>SQLite default · PostgreSQL supported<br/>SQLAlchemy · Alembic")]

    browser <-->|"HTTP / JSON<br/>Bearer token"| routes
    routes --> auth
    auth <--> db
    routes --> inventory
    routes --> forecast
    forecast --> risk
    routes --> risk
    routes --> matching
    routes --> regional
    routes --> other
    inventory --> services
    forecast --> services
    risk --> services
    matching --> services
    regional --> services
    other --> services
    services <--> db

    classDef client fill:#e8f2ff,stroke:#3973b9,color:#17375e,stroke-width:1.5px
    classDef module fill:#f6f0ff,stroke:#8560b3,color:#33234a,stroke-width:1px
    classDef data fill:#eaf7ef,stroke:#428a5b,color:#193c24,stroke-width:1.5px
