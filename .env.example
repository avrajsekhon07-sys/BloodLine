# Docker Compose template. Copy to code/.env and replace both placeholders.
# Never commit code/.env or use these placeholder values outside local development.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
BLOODLINE_SECRET_KEY=replace-with-output-of-python-secrets-token-url-safe-48
ALLOWED_ORIGINS=http://localhost:8080

# Optional Web Push (generate with: python code/backend/scripts/gen_vapid.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional local behavior overrides
# BLOODLINE_SARIMA=0
# BLOODLINE_DEMO_TOOLS=0
# BLOODLINE_DEMO_LOGIN=0
# LOGIN_RATE_LIMIT=1
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# LOGIN_WINDOW_SECONDS=900
